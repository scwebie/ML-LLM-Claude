# market-agent-lab environment configuration
# Copy to .env and fill in as needed. All values below are OPTIONAL for the
# offline synthetic demo (uv run python main.py demo) -- no external network
# access is required to run Version 0.1.

# --- Optional LLM enhancement for research agents -----------------------
# If unset, every research agent runs its deterministic statistical
# fallback and never calls out to a network service.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Local storage --------------------------------------------------------
DATA_STORE_DIR=./data_store
DUCKDB_PATH=./data_store/duckdb/market_agent_lab.duckdb

# --- Synthetic data generation --------------------------------------------
SYNTHETIC_SEED=42
SYNTHETIC_START_DATE=2015-01-01
SYNTHETIC_END_DATE=2023-12-31

# --- API / dashboard -------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Safety -----------------------------------------------------------------
# Hard-coded to true throughout v0.1. Present here only for visibility.
PAPER_TRADING_ONLY=true
