# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Data & artifacts (synthetic data is regenerated, not committed)
data_store/raw/*
data_store/features/*
data_store/models/*
data_store/duckdb/*
data_store/results/*
!data_store/raw/.gitkeep
!data_store/features/.gitkeep
!data_store/models/.gitkeep
!data_store/duckdb/.gitkeep
!data_store/results/.gitkeep
*.duckdb
*.parquet

# On-disk HTTP response cache for external data providers (V0.2) --
# content-hash-keyed JSON blobs regenerated on demand, never committed.
data_store/cache/*
!data_store/cache/.gitkeep

# IDE
.vscode/
.idea/
